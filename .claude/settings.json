{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(npx hyperframes skills:*)",
      "Bash(npx skills add:*)",
      "Bash(npx skills update:*)"
    ]
  },
  "env": {
    "HYPERFRAMES_SKIP_SKILLS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-skills-install.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}